# Learn with Asejik - Environment Configuration Template
# Copy this file to .env.local for local development.
# Never commit actual secret values to version control.

# Site URL for canonical links and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://learn.asejik.com

# Required for pilot signup: webhook URL for the pilot roster (e.g., Google Apps Script).
# SERVER-ONLY: never prefix with NEXT_PUBLIC_ — the URL lets anyone write to the roster.
# If unset, /api/pilot-signup rejects signups with HTTP 503.
PILOT_SIGNUP_WEBHOOK_URL=
