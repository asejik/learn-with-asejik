    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.3.5",
